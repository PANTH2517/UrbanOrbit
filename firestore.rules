rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isOfficial() {
      return isSignedIn() && (role() == 'government_official' || isAdmin());
    }

    // Trust the phone_verified custom claim - set only by api/verifyOtp.js
    // (via the Admin SDK) after a real 2Factor.in SMS OTP check succeeds -
    // rather than a client-writable Firestore field. A citizen can never
    // forge this by editing their own profile document. (Phone verification
    // goes through 2Factor rather than Firebase Phone Auth, which requires
    // the Blaze billing plan to send real SMS - see docs/SECURITY.md.)
    function isPhoneVerifiedCitizen() {
      return isSignedIn() && request.auth.token.phone_verified == true;
    }

    function isCanContribute() {
      return isPhoneVerifiedCitizen() || isOfficial();
    }

    // ---- issues: the public civic reports -------------------------------

    match /issues/{issueId} {
      // Public transparency tool: anyone (including logged-out visitors) can read.
      allow read: if true;

      allow create: if isCanContribute()
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.problem_type in [
             'slum_watch', 'urban_heat_islands', 'pollution_zones', 'disaster_chaos',
             'power_deprivation', 'crime_mapping', 'green_inequality', 'transit_gaps',
             'land_use_violations', 'infra_inequality'
           ]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && (!('description' in request.resource.data) || request.resource.data.description.size() <= 2000)
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180;

      // Citizens cannot edit their own report after submission (matches the
      // original Base44 RLS intent). Only officials/admins may triage it, and only
      // through this fixed set of fields.
      allow update: if isOfficial()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'priority', 'assigned_to', 'resolved_date']);

      allow delete: if isAdmin();
    }

    // ---- users: minimal profile cache (never the source of truth for roles) ---

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---- government official applications --------------------------------

    match /officialApplications/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending';

      // Approval/rejection happens only through scripts/admin-cli.js, run locally
      // with the Admin SDK (which bypasses these rules), so no client - not even
      // an admin's own browser session - can flip status directly. This keeps
      // every approval going through the audit-logged path.
      allow update: if false;
      allow delete: if false;
    }

    // ---- audit log: written only via the Admin SDK (scripts/admin-cli.js) -----

    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- pending phone-OTP sessions: server-only (api/sendOtp.js / api/verifyOtp.js) ----

    match /otpSessions/{uid} {
      allow read, write: if false;
    }
  }
}
