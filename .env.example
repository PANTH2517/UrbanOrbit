# Copy this file to .env and fill in real values from the Firebase console
# (Project settings > General > Your apps > SDK setup and configuration).
# .env is gitignored and must never be committed.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase App Check - reCAPTCHA v3 site key
VITE_RECAPTCHA_SITE_KEY=

# Optional error monitoring (Sentry). Leave blank to run with no monitoring -
# nothing else in the app depends on this being set. Get a DSN by creating a
# free project at https://sentry.io (Platform: React).
VITE_SENTRY_DSN=

# Optional map tile source. Defaults to OpenStreetMap's public tile server,
# which has a light-use policy not meant for real production traffic - swap
# in a paid provider (MapTiler, Stadia Maps, Mapbox) before a real launch.
# Example (MapTiler): https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# --- File storage: Cloudinary (not Firebase Storage - see docs/SECURITY.md) -
# Cloudinary dashboard -> Settings -> Upload -> Upload presets. Create two
# UNSIGNED presets:
#   1. "urbanorbit_public"  - default Access Mode (public) - for issue photos
#   2. "urbanorbit_private" - Access Mode: Authenticated - for official docs
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET_PUBLIC=urbanorbit_public
VITE_CLOUDINARY_UPLOAD_PRESET_PRIVATE=urbanorbit_private

# --- Server-side only (used by api/*.js) -----------------------------------
# NOT prefixed with VITE_ on purpose: Vite only exposes VITE_* vars to the
# browser bundle. These are read by Vercel serverless functions (and by
# `npx vercel dev` locally), never by the frontend.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Citizen phone verification (api/sendOtp.js, api/verifyOtp.js) - NOT
# Firebase Phone Auth, which requires the Blaze billing plan to send real
# SMS. Get an API key from https://2factor.in (dashboard -> API Keys) after
# signing up - their default OTP template works immediately, no DLT
# template registration needed to get started.
TWOFACTOR_API_KEY=
# Optional: only set this if you've registered your own DLT-approved
# template on the 2Factor dashboard for a branded message instead of their
# default one.
TWOFACTOR_OTP_TEMPLATE=

# Cloudinary dashboard home page shows these (Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: makes official-document links (api/getDocumentUrl.js) expire
# after 5 minutes instead of working forever once generated. Requires
# enabling "Strict token-based authentication" in the Cloudinary console
# (Settings -> Security) and using the Auth Token Key it generates there.
# Leave blank to keep the current non-expiring signed-URL behavior.
CLOUDINARY_AUTH_TOKEN_KEY=

# The full contents of serviceAccountKey.json as one single-line JSON string
# (Firebase console > Project settings > Service accounts > Generate new
# private key). In the real Vercel deployment, set this in the project's
# Environment Variables settings instead of a local .env file.
FIREBASE_SERVICE_ACCOUNT=
